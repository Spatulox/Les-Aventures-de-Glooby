[node name="LutinNoel" parent="UsinePereNoelUnderGround/Pnj" unique_id=1597419713 instance=ExtResource("28_ce8ch")]
position = Vector2(2959, -850.45996)
Lignes = PackedStringArray("Si tu tombe, c\'est fini, le néant va t\'aspirer, comme tous les jouets qui y sont tombé !")
DialogueDynamique = true
Contexte = "Tu es un lutin très engagé dans la production de jouet, et tu es très triste car de temps en temps, des jouets tombent dans le néant et on ne les revoit jamais..."

