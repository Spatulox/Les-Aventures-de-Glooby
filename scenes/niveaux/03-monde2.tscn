[node name="Pingouin" parent="UsinePereNoelUnderGround/Pnj" unique_id=1252595758 instance=ExtResource("34_ftbij")]
position = Vector2(2254, 200.54004)
Lignes = PackedStringArray("Hmmm, Comment je vais remonter moi ?")
DialogueDynamique = true
