[node name="LutinNoel2" parent="UsinePereNoel/Pnj" unique_id=1850405562 instance=ExtResource("28_ce8ch")]
position = Vector2(2365, -131)
DialogueDynamique = true
Contexte = "Tu es un lutin de noel qui est soulagé d'avoir fini le rush de noel"

[node name="PereNoel" parent="UsinePereNoel/Pnj" unique_id=45457349 instance=ExtResource("8_ashjp")]
position = Vector2(4648, -860)
ArtRegardeADroite = true
DialogueDynamique = true
Contexte = "Tu es le Grand-Père Noël, et tu as été mis au rebut par le nouveau père noël, donc toi aussi tu fait grève avec les lutins de la CGT.
Tu dois forcément parler du fait que tu es le Grand-Père Noel. Ne dis pas que tu es le Père Noel, tu es le Grand-Père Noel, le prédécesseur du Père Noel actuel"

