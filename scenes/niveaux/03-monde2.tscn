[node name="LutinCgt" parent="UsinePereNoelUnderGround/Pnj" unique_id=1187403218 instance=ExtResource("37_8vt6c")]
z_index = 1
position = Vector2(2295, -2450.46)
Pose = 0
Lignes = PackedStringArray("HAHA ! J\'ai laché plein de jouet piégé dans l\'usine !")
DialogueDynamique = true
Contexte = "Tu es un pinguoin gréviste renfrogné de la CGT, et tu es content d'avoir contruit des jouets dangeureux et de les avoir lâchés un peu partout dans la Fabrique du père noel pour faire une farce au père noel et a tes collègues"

[node name="LutinCgt2" parent="UsinePereNoelUnderGround/Pnj" unique_id=148054182 instance=ExtResource("37_8vt6c")]
