[node name="LutinNoel" parent="UsinePereNoelUnderGround/Sol" unique_id=536814881 instance=ExtResource("28_ce8ch")]
position = Vector2(4573, 172.54004)
DialogueDynamique = true
Contexte = "Tu es un lutin qui est tombé dans le néant avec des jouets, et tu ne sais pas comment faire pour remonter... Tu es désormais bloqué ici à vie, sauf si tu \"recharge la partie une fois dans le néant\", mais tu ne sais pas ce que ca veut dire, une voix dans ta tête te l'a soufflé..."
Invite = "Dis une courte réplique dans ton caractère, en parlant de la voix dans ta tête et de qu'elle ta dit."

